{
  "name": "kcna-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "KCNA-JP の学習サイト。コマンドと YAML の穴埋め・4 択をレッスンで解き、進捗はブラウザの localStorage に残す。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "e2e": "vite build && node scripts/prerender.mjs && node scripts/e2e.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "readme:images": "vite build && node scripts/readme-images.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.7",
    "@heroicons/react": "2.2.0",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.7",
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "opentype.js": "^1.3.4",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
