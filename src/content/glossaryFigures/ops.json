          "sub": "Git に変更を入れる",
          "tone": "muted"
        },
        {
          "id": "ci",
          "x": 176,
          "y": 24,
          "w": 150,
          "h": 52,
          "label": "CI",
          "sub": "統合とテストを自動で",
          "term": "ci"
        },
        {
          "id": "artifact",
          "x": 356,
          "y": 24,
          "w": 120,
          "h": 52,
          "label": "成果物",
          "sub": "リリースの候補"
        },
        {
          "id": "fail",
          "x": 176,
          "y": 130,
          "w": 150,
          "h": 52,
          "label": "失敗",
          "sub": "はっきり失敗した",
          "tone": "warn"
        },
        {
          "id": "cd",
          "x": 500,
          "y": 24,
          "w": 124,
          "h": 52,
          "label": "CD",
          "sub": "環境へ届ける",
          "term": "cd"
        },
        {
          "id": "accept",
          "x": 500,
          "y": 130,
          "w": 124,
          "h": 52,
          "label": "受け入れの環境",
          "sub": "テストの環境",
          "term": "cd"
        },
        {
          "id": "prod",
          "x": 500,
          "y": 226,
          "w": 124,
          "h": 52,
          "label": "本番",
          "sub": "継続的デプロイメント",
