        {
          "from": "cd",
          "to": "accept",
          "label": "自動",
          "fromSide": "bottom",
          "toSide": "top"
        },
        {
          "from": "accept",
          "to": "prod",
          "label": "自動なら",
          "dashed": true,
          "fromSide": "bottom",
          "toSide": "top"
        }
      ]
    }
  },
  {
