  {
    "id": "sli-slo-error-budget",
    "terms": [
      "sli",
      "slo",
      "error-budget"
    ],
    "spec": {
      "caption": "SLI で測る量を決め、その目標が SLO です。1 から SLO を引いた量がエラーバジェットで、99.9% なら 100 万件のうち 1,000 件まで失敗が許されます。残っている間は新しい版を出し、使い切ったら修正のほかは止めます。",
      "width": 640,
      "height": 240,
      "nodes": [
        {
          "id": "sli",
          "x": 16,
          "y": 30,
          "w": 180,
          "h": 52,
